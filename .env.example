# Локальное окружение. Создать: cp .env.example .env
# .env читают и Docker Compose (POSTGRES_* для compose.yaml), и Next.js.
# .env.example коммитится, .env — нет: настоящие секреты пиши только в .env.

# Локальная БД из compose.yaml
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=skillnotfound

# Приложение читает только DATABASE_URL. Локально он собирается из переменных выше,
# в проде задаётся целиком (строка подключения из Supabase).
DATABASE_URL=postgresql://$POSTGRES_USER:$POSTGRES_PASSWORD@localhost:5432/$POSTGRES_DB
